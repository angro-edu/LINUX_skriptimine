#!/bin/bash
# Nimi: Angro Raja
# Skripti nimi: menu
# Ülesande kirjeldus: Skript kuvab toidumenüü, küsib kasutajalt valikut ja väljastab vastava kommentaari.

# Kuvame kasutajale menüü valikud
echo "1) liha ja kartulid"
echo "2) kala ja krõpsud"
echo "3) supp ja salat"

# Küsime kasutajalt valiku numbrit ja salvestame selle muutujasse 'valik'
read -p "Tee oma valik (1 või 2 või 3): " valik

# Kontrollime case-lausega sisestatud numbrit ja väljastame vastava teksti
case $valik in
    1)
        echo "Väga maitsev, aga jälgi oma tervist!"
        echo "Head isu!"
        ;;
    2)
        echo "Brititoit on maisev!"
        echo "Head isu!"
        ;;
    3)
        echo "Nii tervislik ja igav..."
        echo "Head isu!"
        ;;
    *)
        # Veateade, kui sisestati midagi muud peale 1, 2 või 3
        echo "Vigane valik! Palun vali 1, 2 või 3."
        ;;
esac
